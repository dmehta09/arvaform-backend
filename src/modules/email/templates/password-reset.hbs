<html lang='{{language}}'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta http-equiv='X-UA-Compatible' content='IE=edge' />
    <title>Reset Your Password - {{company_name}}</title>
    <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
    <style>
      /* Reset and base styles */
      body,
      table,
      td,
      p,
      a,
      li,
      blockquote {
        -webkit-text-size-adjust: 100%;
        -ms-text-size-adjust: 100%;
      }
      table,
      td {
        mso-table-lspace: 0pt;
        mso-table-rspace: 0pt;
      }
      img {
        -ms-interpolation-mode: bicubic;
        border: 0;
        outline: none;
        text-decoration: none;
      }

      /* Global styles */
      body {
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f8fafc;
        color: #334155;
        line-height: 1.6;
      }

      .email-container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        overflow: hidden;
      }

      .header {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        padding: 40px 30px;
        text-align: center;
      }

      .header h1 {
        color: #ffffff;
        margin: 0;
        font-size: 28px;
        font-weight: 700;
        letter-spacing: -0.5px;
      }

      .header p {
        color: #e2e8f0;
        margin: 8px 0 0 0;
        font-size: 16px;
        opacity: 0.9;
      }

      .content {
        padding: 40px 30px;
      }

      .security-notice {
        background-color: #fef3c7;
        border: 1px solid #f59e0b;
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 30px;
      }

      .security-notice .icon {
        color: #f59e0b;
        font-size: 20px;
        margin-right: 8px;
      }

      .security-notice p {
        margin: 0;
        color: #92400e;
        font-size: 14px;
        font-weight: 500;
      }

      .main-content h2 {
        color: #1e293b;
        font-size: 24px;
        font-weight: 600;
        margin: 0 0 20px 0;
        line-height: 1.3;
      }

      .main-content p {
        color: #475569;
        font-size: 16px;
        margin: 0 0 20px 0;
      }

      .reset-button {
        display: inline-block;
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        color: #ffffff !important;
        text-decoration: none;
        padding: 16px 32px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 16px;
        text-align: center;
        margin: 20px 0 30px 0;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
        transition: all 0.3s ease;
      }

      .reset-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(99, 102, 241, 0.35);
      }

      .expiry-notice {
        background-color: #f1f5f9;
        border-left: 4px solid #6366f1;
        padding: 16px 20px;
        margin: 30px 0;
        border-radius: 0 8px 8px 0;
      }

      .expiry-notice p {
        margin: 0;
        color: #475569;
        font-size: 14px;
      }

      .alternative-method {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 20px;
        margin: 30px 0;
      }

      .alternative-method h3 {
        color: #1e293b;
        font-size: 16px;
        font-weight: 600;
        margin: 0 0 12px 0;
      }

      .alternative-method p {
        margin: 0;
        font-size: 14px;
        color: #64748b;
      }

      .alternative-method .manual-link {
        word-break: break-all;
        background-color: #f1f5f9;
        padding: 8px 12px;
        border-radius: 4px;
        font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
        font-size: 12px;
        margin-top: 12px;
        display: block;
      }

      .footer {
        background-color: #f8fafc;
        padding: 30px;
        text-align: center;
        border-top: 1px solid #e2e8f0;
      }

      .footer p {
        margin: 0 0 12px 0;
        color: #64748b;
        font-size: 14px;
      }

      .footer .support-link {
        color: #6366f1;
        text-decoration: none;
        font-weight: 500;
      }

      .footer .support-link:hover {
        text-decoration: underline;
      }

      .footer .company-info {
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid #e2e8f0;
        color: #94a3b8;
        font-size: 12px;
      }

      /* Responsive styles */
      @media only screen and (max-width: 600px) {
        .email-container {
          margin: 0;
          border-radius: 0;
        }

        .header,
        .content,
        .footer {
          padding: 30px 20px;
        }

        .header h1 {
          font-size: 24px;
        }

        .main-content h2 {
          font-size: 20px;
        }

        .reset-button {
          display: block;
          width: 100%;
          box-sizing: border-box;
        }
      }

      /* Dark mode support */
      @media (prefers-color-scheme: dark) {
        .email-container {
          background-color: #1e293b;
        }

        .main-content h2 {
          color: #f1f5f9;
        }

        .main-content p {
          color: #cbd5e1;
        }

        .alternative-method {
          background-color: #334155;
          border-color: #475569;
        }

        .alternative-method h3 {
          color: #f1f5f9;
        }

        .alternative-method p {
          color: #94a3b8;
        }

        .footer {
          background-color: #0f172a;
          border-color: #334155;
        }
      }
    </style>
  </head>
  <body>
    <div class='email-container'>
      <!-- Header -->
      <div class='header'>
        <h1>🔐 Password Reset</h1>
        <p>Secure access to your {{company_name}} account</p>
      </div>

      <!-- Main Content -->
      <div class='content'>
        <!-- Security Notice -->
        <div class='security-notice'>
          <p><span class='icon'>⚠️</span>
            This is a security-sensitive email. If you didn't request a password reset, please
            ignore this email.</p>
        </div>

        <div class='main-content'>
          <h2>Hello {{user_name}},</h2>

          <p>We received a request to reset the password for your
            {{company_name}}
            account ({{user_email}}). If you made this request, click the button below to choose a
            new password:</p>

          <div style='text-align: center;'>
            <a href='{{reset_url}}' class='reset-button'>Reset My Password</a>
          </div>

          <!-- Expiry Notice -->
          <div class='expiry-notice'>
            <p><strong>Important:</strong>
              This link will expire in
              {{expiry_hours}}
              hours ({{formatDate expiry_time 'long'}}) for your security.</p>
          </div>

          <!-- Alternative Method -->
          <div class='alternative-method'>
            <h3>Can't click the button?</h3>
            <p>Copy and paste this link into your browser:</p>
            <div class='manual-link'>{{reset_url}}</div>
          </div>

          <p><strong>Why did I receive this email?</strong><br />
            This email was sent because someone (hopefully you) requested a password reset for your
            account. If this wasn't you, you can safely ignore this email - your password will
            remain unchanged.</p>

          <p><strong>Need help?</strong><br />
            If you're having trouble resetting your password or have any questions about your
            account security, our support team is here to help.</p>
        </div>
      </div>

      <!-- Footer -->
      <div class='footer'>
        <p>Questions?
          <a href='mailto:{{support_email}}' class='support-link'>Contact our support team</a></p>
        <p>For your security, never share your login credentials or forward this email.</p>

        <div class='company-info'>
          <p>{{company_name}}<br />
            {{#if company_address}}{{company_address}}{{/if}}<br />
            This email was sent to
            {{user_email}}
            because it's associated with a
            {{company_name}}
            account.</p>
        </div>
      </div>
    </div>
  </body>
</html>