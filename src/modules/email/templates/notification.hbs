<!DOCTYPE html>
<html lang="{{language}}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>{{notification_title}} - {{company_name}}</title>
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
  <style>
    /* Reset and base styles */
    body, table, td, p, a, li, blockquote {
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
    }
    table, td {
      mso-table-lspace: 0pt;
      mso-table-rspace: 0pt;
    }
    img {
      -ms-interpolation-mode: bicubic;
      border: 0;
      outline: none;
      text-decoration: none;
    }

    /* Global styles */
    body {
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f8fafc;
      color: #334155;
      line-height: 1.6;
    }

    .email-container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
      border-radius: 12px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
      overflow: hidden;
    }

    /* Priority-based header colors */
    .header {
      padding: 30px;
      text-align: center;
    }

    .header.priority-low {
      background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
    }

    .header.priority-normal {
      background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
    }

    .header.priority-high {
      background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
    }

    .header.priority-urgent {
      background: linear-gradient(135deg, #ef4444 0%, #f87171 100%);
    }

    .notification-icon {
      font-size: 48px;
      margin-bottom: 16px;
      display: block;
    }

    .header h1 {
      color: #ffffff;
      margin: 0;
      font-size: 24px;
      font-weight: 700;
      letter-spacing: -0.5px;
    }

    .header p {
      color: rgba(255, 255, 255, 0.9);
      margin: 8px 0 0 0;
      font-size: 16px;
    }

    .content {
      padding: 40px 30px;
    }

    /* Priority indicator */
    .priority-indicator {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 20px;
    }

    .priority-indicator.low {
      background-color: #d1fae5;
      color: #047857;
    }

    .priority-indicator.normal {
      background-color: #e0e7ff;
      color: #4338ca;
    }

    .priority-indicator.high {
      background-color: #fef3c7;
      color: #d97706;
    }

    .priority-indicator.urgent {
      background-color: #fee2e2;
      color: #dc2626;
    }

    .main-content h2 {
      color: #1e293b;
      font-size: 22px;
      font-weight: 600;
      margin: 0 0 20px 0;
      line-height: 1.3;
    }

    .main-content p {
      color: #475569;
      font-size: 16px;
      margin: 0 0 20px 0;
    }

    /* Notification types styling */
    .notification-details {
      background-color: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 20px;
      margin: 25px 0;
    }

    .notification-details h3 {
      color: #1e293b;
      font-size: 16px;
      font-weight: 600;
      margin: 0 0 12px 0;
    }

    .notification-details .detail-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 0;
      border-bottom: 1px solid #e2e8f0;
    }

    .notification-details .detail-row:last-child {
      border-bottom: none;
    }

    .notification-details .detail-label {
      font-weight: 500;
      color: #64748b;
      font-size: 14px;
    }

    .notification-details .detail-value {
      color: #1e293b;
      font-weight: 500;
      font-size: 14px;
    }

    /* Action buttons */
    .action-buttons {
      text-align: center;
      margin: 30px 0;
    }

    .btn {
      display: inline-block;
      text-decoration: none;
      padding: 12px 24px;
      border-radius: 6px;
      font-weight: 600;
      font-size: 14px;
      text-align: center;
      margin: 0 8px 8px 0;
      transition: all 0.3s ease;
    }

    .btn-primary {
      background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
      color: #ffffff !important;
      box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(99, 102, 241, 0.35);
    }

    .btn-secondary {
      background-color: #f1f5f9;
      color: #475569 !important;
      border: 1px solid #e2e8f0;
    }

    .btn-secondary:hover {
      background-color: #e2e8f0;
    }

    /* Message content */
    .message-content {
      background-color: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 20px;
      margin: 25px 0;
      white-space: pre-line;
    }

    .message-content.with-html {
      white-space: normal;
    }

    /* Timestamp */
    .timestamp {
      background-color: #f1f5f9;
      border-left: 4px solid #6366f1;
      padding: 12px 16px;
      margin: 20px 0;
      border-radius: 0 6px 6px 0;
    }

    .timestamp p {
      margin: 0;
      color: #475569;
      font-size: 14px;
    }

    .footer {
      background-color: #f8fafc;
      padding: 30px;
      text-align: center;
      border-top: 1px solid #e2e8f0;
    }

    .footer p {
      margin: 0 0 12px 0;
      color: #64748b;
      font-size: 14px;
    }

    .footer .unsubscribe-link {
      color: #6366f1;
      text-decoration: none;
      font-weight: 500;
    }

    .footer .unsubscribe-link:hover {
      text-decoration: underline;
    }

    .footer .company-info {
      margin-top: 20px;
      padding-top: 20px;
      border-top: 1px solid #e2e8f0;
      color: #94a3b8;
      font-size: 12px;
    }

    /* Responsive styles */
    @media only screen and (max-width: 600px) {
      .email-container {
        margin: 0;
        border-radius: 0;
      }

      .header, .content, .footer {
        padding: 30px 20px;
      }

      .notification-icon {
        font-size: 36px;
      }

      .header h1 {
        font-size: 20px;
      }

      .main-content h2 {
        font-size: 18px;
      }

      .notification-details .detail-row {
        flex-direction: column;
        align-items: flex-start;
      }

      .notification-details .detail-value {
        margin-top: 4px;
      }

      .btn {
        display: block;
        width: 100%;
        box-sizing: border-box;
        margin: 0 0 12px 0;
      }
    }

    /* Dark mode support */
    @media (prefers-color-scheme: dark) {
      .email-container {
        background-color: #1e293b;
      }

      .main-content h2 {
        color: #f1f5f9;
      }

      .main-content p {
        color: #cbd5e1;
      }

      .notification-details {
        background-color: #334155;
        border-color: #475569;
      }

      .notification-details h3 {
        color: #f1f5f9;
      }

      .notification-details .detail-value {
        color: #f1f5f9;
      }

      .message-content {
        background-color: #334155;
        border-color: #475569;
        color: #cbd5e1;
      }

      .footer {
        background-color: #0f172a;
        border-color: #334155;
      }
    }
  </style>
</head>
<body>
  <div class="email-container">
    <!-- Header with priority-based styling -->
    <div class="header {{#if priority}}priority-{{priority}}{{else}}priority-normal{{/if}}">
      {{#if notification_icon}}
        <span class="notification-icon">{{notification_icon}}</span>
      {{else}}
        {{#if_eq notification_type 'form_submission'}}<span class="notification-icon">📝</span>{{/if_eq}}
        {{#if_eq notification_type 'system_alert'}}<span class="notification-icon">⚠️</span>{{/if_eq}}
        {{#if_eq notification_type 'security'}}<span class="notification-icon">🔒</span>{{/if_eq}}
        {{#if_eq notification_type 'update'}}<span class="notification-icon">🔄</span>{{/if_eq}}
        {{#if_eq notification_type 'reminder'}}<span class="notification-icon">⏰</span>{{/if_eq}}
        {{#if_eq notification_type 'success'}}<span class="notification-icon">✅</span>{{/if_eq}}
        {{#if_eq notification_type 'warning'}}<span class="notification-icon">⚠️</span>{{/if_eq}}
        {{#if_eq notification_type 'error'}}<span class="notification-icon">❌</span>{{/if_eq}}
        {{#if_eq notification_type 'info'}}<span class="notification-icon">ℹ️</span>{{/if_eq}}
      {{/if}}

      <h1>{{notification_title}}</h1>
      {{#if notification_subtitle}}
        <p>{{notification_subtitle}}</p>
      {{/if}}
    </div>

    <!-- Main Content -->
    <div class="content">
      <!-- Priority Indicator -->
      {{#if priority}}
        <div class="priority-indicator {{priority}}">{{priority}} Priority</div>
      {{/if}}

      <div class="main-content">
        <h2>Hello {{#if user_name}}{{user_name}}{{else}}valued user{{/if}},</h2>

        {{#if notification_message}}
          <p>{{notification_message}}</p>
        {{/if}}

        <!-- Notification Details -->
        {{#if details}}
          <div class="notification-details">
            <h3>Details</h3>
            {{#each details}}
              <div class="detail-row">
                <span class="detail-label">{{@key}}:</span>
                <span class="detail-value">{{this}}</span>
              </div>
            {{/each}}
          </div>
        {{/if}}

        <!-- Form Submission specific details -->
        {{#if_eq notification_type 'form_submission'}}
          <div class="notification-details">
            <h3>Form Submission Details</h3>
            <div class="detail-row">
              <span class="detail-label">Form:</span>
              <span class="detail-value">{{form_title}}</span>
            </div>
            {{#if submission_count}}
              <div class="detail-row">
                <span class="detail-label">Total Submissions:</span>
                <span class="detail-value">{{submission_count}}</span>
              </div>
            {{/if}}
            {{#if submitted_at}}
              <div class="detail-row">
                <span class="detail-label">Submitted:</span>
                <span class="detail-value">{{formatDate submitted_at 'long'}}</span>
              </div>
            {{/if}}
          </div>
        {{/if}}

        <!-- Message Content -->
        {{#if message_content}}
          <div class="message-content {{#if contains_html}}with-html{{/if}}">
            {{#if contains_html}}
              {{{message_content}}}
            {{else}}
              {{message_content}}
            {{/if}}
          </div>
        {{/if}}

        <!-- Action Buttons -->
        {{#if actions}}
          <div class="action-buttons">
            {{#each actions}}
              <a href="{{url}}" class="btn {{#if primary}}btn-primary{{else}}btn-secondary{{/if}}">{{label}}</a>
            {{/each}}
          </div>
        {{/if}}

        <!-- Default actions for specific notification types -->
        {{#if_eq notification_type 'form_submission'}}
          <div class="action-buttons">
            <a href="{{dashboard_url}}" class="btn btn-primary">View Dashboard</a>
            {{#if submission_url}}
              <a href="{{submission_url}}" class="btn btn-secondary">View Submission</a>
            {{/if}}
          </div>
        {{/if_eq}}

        <!-- Timestamp -->
        {{#if timestamp}}
          <div class="timestamp">
            <p><strong>Notification sent:</strong> {{formatDate timestamp 'long'}}</p>
          </div>
        {{/if}}

        {{#if additional_info}}
          <p><small>{{additional_info}}</small></p>
        {{/if}}
      </div>
    </div>

    <!-- Footer -->
    <div class="footer">
      {{#if show_unsubscribe}}
        <p>You're receiving this because you're subscribed to {{company_name}} notifications.</p>
        <p><a href="{{unsubscribe_url}}" class="unsubscribe-link">Manage notification preferences</a></p>
      {{/if}}

      <div class="company-info">
        <p>{{company_name}}<br>
        {{#if company_address}}{{company_address}}{{/if}}<br>
        This notification was sent to {{user_email}}{{#if notification_reason}} {{notification_reason}}{{/if}}.</p>
      </div>
    </div>
  </div>
</body>
</html>